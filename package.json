{
  "name": "shohoj",
  "version": "0.5.0",
  "description": "BRACU academic tools platform",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node scripts/run-tests.mjs && npm run test:rules && npm run test:backfill",
    "test:unit": "node scripts/run-tests.mjs",
    "test:one": "node scripts/run-tests.mjs",
    "test:worker": "node worker/test/worker.test.js",
    "dev": "vite",
    "dev:shell": "vite --config vite.shell.config.js",
    "build:vite": "vite build",
    "build:shell": "vite build --config vite.shell.config.js",
    "dev:pages": "vite --config vite.pages.config.js",
    "build:pages": "vite build --config vite.pages.config.js",
    "preview": "vite preview",
    "preview:shell": "vite preview --config vite.shell.config.js",
    "preview:pages": "vite preview --config vite.pages.config.js",
    "test:rules": "firebase emulators:exec --only firestore --project shohoj-test \"node tests/firestore.rules.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:vite": "npm run build:vite && playwright test --config=playwright.vite.config.js",
    "test:e2e:shell": "npm run build:shell && playwright test --config=playwright.shell.config.js",
    "test:e2e:pages": "npm run build:pages && playwright test --config=playwright.pages.config.js",
    "test:a11y": "npm run build:shell && playwright test --config=playwright.shell.config.js --grep @a11y",
    "test:visual:baseline": "VISUAL_LEGACY_ONLY=1 playwright test --config=playwright.visual.config.js --project=legacy --update-snapshots",
    "test:visual": "npm run build:shell && playwright test --config=playwright.visual.config.js",
    "test:bundle": "node tests/productionBundleSmoke.test.js",
    "test:csp": "node tests/cspInlineHandlers.test.js",
    "check:collisions": "python3 scripts/check_bundle_collisions.py",
    "generate:worker-catalog": "node scripts/generate_worker_catalog.mjs",
    "check:worker-catalog": "node scripts/generate_worker_catalog.mjs --check",
    "generate:worker-reviews": "node scripts/generate_worker_reviews.mjs",
    "generate:campus-map": "node scripts/generate_campus_map.mjs",
    "check:campus-map": "node scripts/generate_campus_map.mjs --check",
    "check:worker-reviews": "node scripts/generate_worker_reviews.mjs --check",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"worker/index.js\" \"worker/assistant.js\" \"worker/assistantProviders.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"worker/index.js\" \"worker/assistant.js\" \"worker/assistantProviders.js\"",
    "validate:data": "node scripts/validate_data.mjs",
    "typecheck": "tsc --noEmit",
    "set:admin": "node scripts/set_admin_claim.js",
    "config:local": "node scripts/generate_runtime_config.js",
    "backfill:campus": "node scripts/backfill_campus.js",
    "test:backfill": "firebase emulators:exec --only firestore --project shohoj-test \"node tests/backfillCampus.test.js\""
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.7.0",
    "firebase-admin": "^14.1.0",
    "firebase-tools": "^15.25.1",
    "globals": "^17.9.0",
    "prettier": "3.9.6",
    "qrcode-generator": "^2.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": ">=11.1.1"
  }
}
