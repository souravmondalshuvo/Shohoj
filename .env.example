# Public Firebase web config — safe to ship to the browser, but kept out of
# source so the repo does not show project identifiers. Copy this file to
# .env.local and fill in values from Firebase Console → Project settings.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google Analytics measurement ID (G-XXXXXXXX).
GA_MEASUREMENT_ID=

# Cloudflare Worker URL that serves past-paper metadata/files.
PAPERS_WORKER_URL=

# Public reCAPTCHA v3 site key used by Firebase App Check. Safe to ship in
# the bundled JS — pairs with a private secret stored in Firebase Console.
RECAPTCHA_V3_SITE_KEY=

# Google OAuth *Web* client ID used by the Google One Tap sign-in prompt
# (Cloud Console → APIs & Services → Credentials → "Web client (auto created
# by Google Service)"). Looks like 1234567890-abc.apps.googleusercontent.com.
# Safe to ship in the browser. Optional — leave blank to disable One Tap; the
# explicit "Sign in" button and nudge banner still work without it.
GOOGLE_OAUTH_CLIENT_ID=
