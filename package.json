{
  "name": "shohoj",
  "version": "0.4.0",
  "description": "BRACU academic tools platform",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node scripts/run-tests.mjs && npm run test:rules",
    "test:unit": "node scripts/run-tests.mjs",
    "test:one": "node scripts/run-tests.mjs",
    "test:worker": "node worker/test/worker.test.js",
    "dev": "vite",
    "build:vite": "vite build",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project shohoj-test \"node tests/firestore.rules.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:vite": "npm run build:vite && playwright test --config=playwright.vite.config.js",
    "test:bundle": "node tests/productionBundleSmoke.test.js",
    "typecheck": "tsc --noEmit",
    "set:admin": "node scripts/set_admin_claim.js",
    "config:local": "node scripts/generate_runtime_config.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.0.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.5"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "uuid": ">=11.1.1"
  }
}
