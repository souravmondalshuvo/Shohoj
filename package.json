{
  "name": "shohoj",
  "version": "0.3.0",
  "description": "BRACU academic tools platform",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/calculator.test.js && node tests/parser.test.js && node tests/tracker.test.js && node tests/render.test.js && node tests/planner.test.js && node tests/typedCoreParity.test.js && node tests/reviews.test.js && node tests/adminDashboard.test.js && node worker/test/worker.test.js && npm run test:rules",
    "test:calculator": "node tests/calculator.test.js",
    "test:parser": "node tests/parser.test.js",
    "test:tracker": "node tests/tracker.test.js",
    "test:render": "node tests/render.test.js",
    "test:planner": "node tests/planner.test.js",
    "test:typed": "node tests/typedCoreParity.test.js",
    "test:reviews": "node tests/reviews.test.js",
    "test:admin": "node tests/adminDashboard.test.js",
    "test:worker": "node worker/test/worker.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project shohoj-test \"node tests/firestore.rules.test.js\"",
    "test:e2e": "playwright test",
    "test:bundle": "node tests/productionBundleSmoke.test.js",
    "typecheck": "tsc --noEmit",
    "set:admin": "node scripts/set_admin_claim.js",
    "config:local": "node scripts/generate_runtime_config.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.0.0",
    "typescript": "^6.0.3"
  }
}
