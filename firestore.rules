rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isAdmin() {
      // Admins are tagged with a custom claim set via scripts/set_admin_claim.js;
      // see PROJECT_README for setup. UID/email are no longer trusted here.
      return request.auth != null
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    // ── Campus tenancy ───────────────────────────────────────────────────
    // Mirrors src/core/university.ts. Two rules keep the campuses apart:
    //
    //   1. A user's campus is derived from their verified email domain, never
    //      read from anything the client controls.
    //   2. A document belongs to the campus in its `university` field.
    //
    // The email is the source of truth rather than a custom claim: a claim
    // needs a provisioning round-trip before a first-time user can read
    // anything, and the domain already carries the answer. If per-user
    // overrides are ever needed (transfers, changed addresses) a claim can be
    // layered on top of campusOfEmail without touching any collection below.
    //
    // Anchored ^...$ on purpose: an unanchored match would let
    // `x@g.bracu.ac.bd.attacker.com` read BRACU data. The generator escapes the
    // dots and anchors both ends; tests/campusMap.test.js asserts a
    // subdomain-suffix address is rejected.
    // BEGIN GENERATED campusOfEmail — npm run generate:campus-map
    function campusOfEmail(addr) {
      return addr.matches('^[^@]+@g[.]bracu[.]ac[.]bd$')
        ? 'bracu'
        : (addr.matches('^[^@]+@northsouth[.]edu$')
          ? 'nsu'
          : '');
    }
    // END GENERATED campusOfEmail

    function userCampus() {
      return (request.auth != null && request.auth.token.email is string)
        ? campusOfEmail(request.auth.token.email)
        : '';
    }

    // A document written before tenancy existed has no `university` field, and
    // every one of those is BRACU's by definition — the app served nobody else.
    // Reads therefore default a missing field to 'bracu'. Creates do NOT get
    // that courtesy: every validator below requires the field explicitly, so a
    // new document can never fall into another campus by omission.
    //
    // This default covers READS ONLY, and that limit matters. A query that
    // filters `where('university','==','bracu')` does not match a document
    // where the field is absent — it is not a null comparison, the document is
    // simply not in that index. So client queries must not be scoped by campus
    // until scripts/backfill_campus.js has stamped the existing documents;
    // doing it the other way round hides every pre-tenancy document from the
    // students it belongs to, while these rules go on permitting reads nobody
    // is asking for any more.
    function docCampus(data) {
      return 'university' in data ? data.university : 'bracu';
    }

    // Takes the whole `resource`, not `resource.data`, because a read of a
    // document that does not exist has `resource == null` — dereferencing
    // `.data` on it is an evaluation error, which denies the read instead of
    // letting Firestore answer "not found" as it always did. A missing document
    // has no campus and nothing to leak, so it passes the check.
    function campusMatches(res) {
      return isAdmin() || res == null || docCampus(res.data) == userCampus();
    }

    // BEGIN GENERATED validCampus — npm run generate:campus-map
    function validCampus(value) {
      return value is string && (value == 'bracu' || value == 'nsu');
    }
    // END GENERATED validCampus

    // The caller's own campus, and only their own — a client cannot label a
    // document as belonging somewhere it is not.
    //
    // Checked only when the field is PRESENT. It is deliberately optional on
    // create, because two clients write these collections and they cannot be
    // upgraded atomically: the legacy bundle at the site root sends no campus,
    // the React shell under /app/ does. Requiring it would deny every legacy
    // create the moment these rules deploy — and the legacy bundle is the main
    // production app. A missing field reads back as 'bracu' via docCampus,
    // which is correct: legacy admits BRACU accounts only.
    function writingOwnCampus(data) {
      return 'university' in data
        && validCampus(data.university)
        && data.university == userCampus();
    }

    function isVerifiedCampusUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && userCampus() != ''
        && request.auth.token.firebase is map
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isCampusUser() {
      return isAdmin() || isVerifiedCampusUser();
    }

    function validReviewId(id) {
      return id is string
        && id.matches('^[A-Z]{2,6}_[A-Z]{2,4}[0-9]{3}[A-Z]?_[a-f0-9]{64}$');
    }

    function validReviewReportPayload(d) {
      return d.keys().hasOnly(['reviewId','reason','reporterUid','createdAt'])
        && d.keys().hasAll(['reviewId','reason','reporterUid','createdAt'])
        && validReviewId(d.reviewId)
        && exists(/databases/$(database)/documents/facultyReviews/$(d.reviewId))
        && d.reason is string
        && d.reason.size() >= 3
        && d.reason.size() <= 300
        && d.reporterUid is string
        && d.reporterUid == request.auth.uid
        && d.createdAt == request.time;
    }

    // ── User data: scoped to own UID, BRACU domain only ──────────────────
    // Doc shape is constrained to {data: <serialized JSON string>, updatedAt}
    // and capped at 500 KB to bound storage abuse by individual users.
    function validUserDocPayload(d) {
      return d.keys().hasOnly(['data', 'updatedAt'])
        && 'data' in d
        && d.data is string
        && d.data.size() <= 500000
        && (!('updatedAt' in d) || d.updatedAt == request.time);
    }

    match /users/{uid} {
      allow read, delete: if isCampusUser() && request.auth.uid == uid;
      allow create, update: if isCampusUser()
        && request.auth.uid == uid
        && validUserDocPayload(request.resource.data);
    }

    // ── Faculty reviews: BRACU students can read; writes go via the Worker ──
    // Each review doc uses a DETERMINISTIC ID:
    //   {facultyInitials}_{courseCode}_{64-char lowercase hex}
    // where the hex suffix = sha256(uid + '|' + facultyInitials + '|' + courseCode).
    //
    // The Cloudflare Worker (worker/index.js POST /reviews) is the ONLY
    // writer — it computes the hash server-side using the verified Firebase
    // uid and writes via the Firestore REST API with a service-account OAuth
    // token, which bypasses these rules. Client-side creates are denied so
    // that the deterministic-ID guarantee can't be subverted by spamming
    // arbitrary hex suffixes.
    match /facultyReviews/{reviewId} {
      // The Worker is the only writer and must stamp `university` on new
      // reviews; pre-tenancy reviews have no field and read as BRACU's.
      allow read: if isCampusUser() && campusMatches(resource);
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // ── Review reports (abuse flagging) ──────────────────────────────────
    // Any signed-in BRACU user can create one report per review. Reports are
    // not readable from the client — admins triage via the Firebase console /
    // admin SDK.
    match /reviewReports/{reportId} {
      allow read: if isAdmin();

      allow create: if isCampusUser()
        && validReviewReportPayload(request.resource.data)
        && reportId == request.auth.uid + '_' + request.resource.data.reviewId;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Faculty profiles: read-only for students, admin-seeded ───────────
    match /facultyProfiles/{initials} {
      allow read: if isCampusUser() && campusMatches(resource);
      allow write: if false;
    }

    // ── App feedback ─────────────────────────────────────────────────────
    function validFeedbackType(t) {
      return t == 'bug' || t == 'feature' || t == 'general';
    }

    function validFeedbackPayload(d) {
      return d.keys().hasOnly(['type','text','context','anonymous','uid','university','createdAt'])
        && d.keys().hasAll(['type','text','anonymous','createdAt'])
        && (!('university' in d) || writingOwnCampus(d))
        && validFeedbackType(d.type)
        && d.text is string
        && d.text.size() >= 3
        && d.text.size() <= 500
        && d.anonymous is bool
        && d.createdAt == request.time
        && (!('context' in d) || (d.context is map && d.context.size() <= 8))
        // Tie uid to the anonymous flag: anonymous feedback must store no
        // identity (uid absent or null), and named feedback must carry the
        // caller's own uid. appFeedback is readable by every BRACU user, so a
        // uid leaking onto "anonymous" feedback would de-anonymise the author.
        && (d.anonymous
              ? (!('uid' in d) || d.uid == null)
              : ('uid' in d && d.uid == request.auth.uid));
    }

    match /appFeedback/{feedbackId} {
      allow read:   if isCampusUser() && campusMatches(resource);
      allow create: if isCampusUser() && validFeedbackPayload(request.resource.data);
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /appFeedbackUpvotes/{voteId} {
      allow read:   if isAdmin() || (isCampusUser() && resource.data.uid == request.auth.uid);
      allow create: if isCampusUser()
        && request.resource.data.keys().hasOnly(['feedbackId','uid','createdAt'])
        && request.resource.data.keys().hasAll(['feedbackId','uid','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.feedbackId is string
        && request.resource.data.feedbackId.size() > 0
        && request.resource.data.createdAt == request.time
        && voteId == request.resource.data.feedbackId + '_' + request.auth.uid;
      allow delete: if isCampusUser() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── Past papers & notes library (Phase 2) ────────────────────────────
    // Doc IDs are Firestore auto-IDs (multiple uploads per user/course are
    // allowed). Clients cannot create metadata directly; the Cloudflare Worker
    // validates the upload, stores the file in R2, writes the Firestore doc via
    // a service account, and initializes each upload with `approved: false`.

    function validPaperReportPayload(d) {
      return d.keys().hasOnly(['paperId','reason','reporterUid','createdAt'])
        && d.keys().hasAll(['paperId','reason','reporterUid','createdAt'])
        && d.paperId is string
        && d.paperId.size() > 0
        && exists(/databases/$(database)/documents/papers/$(d.paperId))
        && d.reason is string
        && d.reason.size() >= 3
        && d.reason.size() <= 300
        && d.reporterUid is string
        && d.reporterUid == request.auth.uid
        && d.createdAt == request.time;
    }

    match /papers/{paperId} {
      // Campus scoping wraps the whole student branch, so it applies to a
      // student's own pending upload as well as to approved papers. The Worker
      // must stamp `university` when it writes the metadata doc.
      allow read:   if isAdmin()
                    || (isCampusUser()
                        && campusMatches(resource)
                        && (resource.data.approved == true
                            || resource.data.uploaderUid == request.auth.uid));
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /paperReports/{reportId} {
      allow read:   if isAdmin();
      allow create: if isCampusUser()
        && validPaperReportPayload(request.resource.data)
        && reportId == request.auth.uid + '_' + request.resource.data.paperId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Admin audit logs ─────────────────────────────────────────────────
    // Append-only record of moderation actions. Admins can read, authors
    // can create their own entries (adminUid must match their token), and
    // nothing can be updated or deleted from the client — even by admins.
    function validAdminLogAction(a) {
      return a == 'approve_paper'
          || a == 'delete_paper'
          || a == 'delete_review'
          || a == 'delete_paper_report'
          || a == 'delete_review_report'
          || a == 'delete_feedback'
          || a == 'delete_study_group'
          || a == 'delete_study_group_report';
    }

    function validAdminLogPayload(d) {
      return d.keys().hasOnly(['action','adminUid','targetType','targetId','meta','createdAt'])
        && d.keys().hasAll(['action','adminUid','targetType','targetId','createdAt'])
        && validAdminLogAction(d.action)
        && d.adminUid is string
        && d.adminUid == request.auth.uid
        && d.targetType is string
        && d.targetType.size() <= 40
        && d.targetId is string
        && d.targetId.size() > 0
        && d.targetId.size() <= 200
        && (!('meta' in d) || (d.meta is map && d.meta.size() <= 16))
        && d.createdAt == request.time;
    }

    match /adminLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin() && validAdminLogPayload(request.resource.data);
      allow update, delete: if false;
    }

    // ── Seat-drop email alerts ───────────────────────────────────────────
    // A user owns their watch doc at seatAlertWatches/{uid}. The email is
    // pinned to the caller's own verified token email, so a user can never make
    // the cron Worker send alerts to someone else's inbox. Per-section element
    // shape is validated by the Worker (rules can't iterate a list of maps);
    // the list is size-capped here to bound abuse. The Worker reads these via a
    // service-account token (bypassing rules) and never trusts client-stored
    // state — its own state lives in seatAlertState, closed to all clients.
    function validSeatAlertWatchPayload(d) {
      return d.keys().hasOnly(['email','enabled','sections','updatedAt'])
        && d.keys().hasAll(['email','enabled','sections','updatedAt'])
        && d.email is string
        && d.email == request.auth.token.email
        && d.enabled is bool
        && d.sections is list
        && d.sections.size() <= 50
        && d.updatedAt == request.time;
    }

    match /seatAlertWatches/{uid} {
      allow read, delete: if isVerifiedCampusUser() && request.auth.uid == uid;
      allow create, update: if isVerifiedCampusUser()
        && request.auth.uid == uid
        && validSeatAlertWatchPayload(request.resource.data);
    }

    // Worker-managed per-user transition state. Never readable or writable from
    // a client; the cron Worker reaches it with a service-account token.
    match /seatAlertState/{uid} {
      allow read, write: if false;
    }

    // ── Study group finder (Phase 2 community) ───────────────────────────
    // A BRACU student posts a study group for a course; other students browse
    // and join. Direct client writes, gated below (no Worker). The contact
    // invite link is public to all BRACU users (the primary "connect" path);
    // the member email roster lives in studyGroupMembers and is readable only
    // to fellow members. Group docs are immutable once created (no update) —
    // edits would let a creator bait-and-switch a joined roster.
    function validStudyGroupMode(m) {
      return m == 'online' || m == 'in-person' || m == 'hybrid';
    }

    function validStudyGroupPayload(d) {
      return d.keys().hasOnly(['courseCode','title','description','mode','schedule','contactLink','capacity','creatorUid','university','createdAt'])
        && d.keys().hasAll(['courseCode','title','mode','contactLink','capacity','creatorUid','createdAt'])
        && (!('university' in d) || writingOwnCampus(d))
        && d.courseCode is string
        && d.courseCode.matches('^[A-Z]{2,4}[0-9]{3}[A-Z]?$')
        && d.title is string
        && d.title.size() >= 3
        && d.title.size() <= 80
        && (!('description' in d) || (d.description is string && d.description.size() <= 500))
        && validStudyGroupMode(d.mode)
        && (!('schedule' in d) || (d.schedule is string && d.schedule.size() <= 120))
        && d.contactLink is string
        && d.contactLink.matches('^https://.*')
        && d.contactLink.size() <= 300
        && d.capacity is int
        && d.capacity >= 2
        && d.capacity <= 50
        && d.creatorUid is string
        && d.creatorUid == request.auth.uid
        && d.createdAt == request.time;
    }

    match /studyGroups/{groupId} {
      allow read:   if isCampusUser() && campusMatches(resource);
      allow create: if isVerifiedCampusUser()
        && validStudyGroupPayload(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin()
        || (isVerifiedCampusUser() && resource.data.creatorUid == request.auth.uid);
    }

    // Per-user membership. Doc ID is `{groupId}_{uid}`; the email is pinned to
    // the caller's verified token email (like seatAlertWatches) so joining can
    // never publish someone else's address. A member doc is readable by the
    // owner, an admin, or a FELLOW MEMBER of the same group (the exists() check)
    // — non-members see only the join count-gated state, so emails stay opt-in.
    function validStudyGroupMemberPayload(d, groupId) {
      return d.keys().hasOnly(['groupId','uid','email','joinedAt'])
        && d.keys().hasAll(['groupId','uid','email','joinedAt'])
        && d.groupId is string
        && d.groupId == groupId
        && d.uid is string
        && d.uid == request.auth.uid
        && d.email is string
        && d.email == request.auth.token.email
        && exists(/databases/$(database)/documents/studyGroups/$(groupId))
        && d.joinedAt == request.time;
    }

    match /studyGroupMembers/{memberId} {
      allow read: if isAdmin()
        || (isVerifiedCampusUser() && resource.data.uid == request.auth.uid)
        || (isVerifiedCampusUser()
            && exists(/databases/$(database)/documents/studyGroupMembers/$(resource.data.groupId + '_' + request.auth.uid)));
      allow create: if isVerifiedCampusUser()
        && memberId == request.resource.data.groupId + '_' + request.auth.uid
        && validStudyGroupMemberPayload(request.resource.data, request.resource.data.groupId);
      allow update: if false;
      allow delete: if isAdmin()
        || (isVerifiedCampusUser() && resource.data.uid == request.auth.uid);
    }

    // Abuse flagging, mirrors paperReports: write-only from the client, one
    // report per user per group, must point at a real group; admins triage.
    function validStudyGroupReportPayload(d) {
      return d.keys().hasOnly(['groupId','reason','reporterUid','createdAt'])
        && d.keys().hasAll(['groupId','reason','reporterUid','createdAt'])
        && d.groupId is string
        && d.groupId.size() > 0
        && exists(/databases/$(database)/documents/studyGroups/$(d.groupId))
        && d.reason is string
        && d.reason.size() >= 3
        && d.reason.size() <= 300
        && d.reporterUid is string
        && d.reporterUid == request.auth.uid
        && d.createdAt == request.time;
    }

    match /studyGroupReports/{reportId} {
      allow read:   if isAdmin();
      allow create: if isCampusUser()
        && validStudyGroupReportPayload(request.resource.data)
        && reportId == request.auth.uid + '_' + request.resource.data.groupId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Lost & found board (Phase 3, #371) ───────────────────────────────
    // Privacy model: posts carry NO contact info. The poster's email lives in
    // lostFoundContacts (never client-readable); a claim queues a Worker-sent
    // email to the poster that shares the claimer's own address. Posts are
    // immutable except the owner closing them (open → resolved) — edits would
    // let a poster bait-and-switch after claims went out.
    function validLostFoundType(t) {
      return t == 'lost' || t == 'found';
    }

    function validLostFoundPostPayload(d) {
      return d.keys().hasOnly(['type','title','description','locationHint','roomCode','status','creatorUid','university','createdAt'])
        && d.keys().hasAll(['type','title','status','creatorUid','createdAt'])
        && (!('university' in d) || writingOwnCampus(d))
        && validLostFoundType(d.type)
        && d.title is string
        && d.title.size() >= 3
        && d.title.size() <= 80
        && (!('description' in d) || (d.description is string && d.description.size() <= 500))
        && (!('locationHint' in d) || (d.locationHint is string && d.locationHint.size() <= 120))
        && (!('roomCode' in d) || (d.roomCode is string && d.roomCode.matches('^[0-9]{2}[A-Z]-[0-9]{2,3}[A-Z]$')))
        && d.status == 'open'
        && d.creatorUid is string
        && d.creatorUid == request.auth.uid
        && d.createdAt == request.time;
    }

    match /lostFoundPosts/{postId} {
      allow read:   if isCampusUser() && campusMatches(resource);
      allow create: if isVerifiedCampusUser()
        && validLostFoundPostPayload(request.resource.data);
      allow update: if isVerifiedCampusUser()
        && resource.data.creatorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'resolved';
      allow delete: if isAdmin()
        || (isVerifiedCampusUser() && resource.data.creatorUid == request.auth.uid);
    }

    // Poster contact, keyed by post id. getAfter() ties creation to a post
    // created by the same caller in the SAME batch, so nobody can attach a
    // contact to someone else's post; only the cron Worker (service-account
    // token, bypasses rules) ever reads it.
    function validLostFoundContactPayload(d, postId) {
      return d.keys().hasOnly(['email','uid','createdAt'])
        && d.keys().hasAll(['email','uid','createdAt'])
        && d.email is string
        && d.email == request.auth.token.email
        && d.uid is string
        && d.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/lostFoundPosts/$(postId)).data.creatorUid == request.auth.uid
        && d.createdAt == request.time;
    }

    match /lostFoundContacts/{postId} {
      allow read:   if false;
      allow create: if isVerifiedCampusUser()
        && validLostFoundContactPayload(request.resource.data, postId);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Claim queue ("I found this / this is mine"): write-only from clients,
    // one claim per user per post via the deterministic id. The Worker
    // consumes the queue and emails the poster; fromEmail is pinned to the
    // claimer's verified token email so a claim can never spoof a sender.
    function validLostFoundClaimPayload(d) {
      return d.keys().hasOnly(['postId','fromUid','fromEmail','note','createdAt'])
        && d.keys().hasAll(['postId','fromUid','fromEmail','createdAt'])
        && d.postId is string
        && exists(/databases/$(database)/documents/lostFoundPosts/$(d.postId))
        && d.fromUid is string
        && d.fromUid == request.auth.uid
        && d.fromEmail is string
        && d.fromEmail == request.auth.token.email
        && (!('note' in d) || (d.note is string && d.note.size() <= 300))
        && d.createdAt == request.time;
    }

    match /lostFoundClaims/{claimId} {
      allow read:   if isAdmin();
      allow create: if isVerifiedCampusUser()
        && validLostFoundClaimPayload(request.resource.data)
        && claimId == request.resource.data.postId + '_' + request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Catch-all: deny everything else ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
