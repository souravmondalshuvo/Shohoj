# Vite build output / cache — Vite runs beside build3.py (deploy still via gh-pages).
dist/
dist-shell/
dist-pages/
.vite/

# Scraped CONNECT section data — input artifact, re-fetched as needed.
bracu-section.json

# Output of scripts/import_semester_snapshot.mjs (#633): a converted semester
# payload and the merged manifest, staged for upload to R2. Regenerated from
# the snapshot above on demand, and the payload alone is ~1.9MB — it belongs in
# the bucket, not in git.
semester-*.json
semesters-index-*.json
current-index.json

# Python bytecode cache (build3.py is imported by the build/test scripts).
__pycache__/
*.pyc

# iCloud Drive conflict copies. The repo lives under ~/Documents, which iCloud
# syncs, and it periodically clones files as "<name> 2.tsx", "<name> 3.ts", …
# They are byte-identical dead copies that otherwise show up as a huge untracked
# diff (3,526 lines of them on 2026-07-30) and are easy to sweep into a commit.
* [0-9].*
* [0-9][0-9].*
