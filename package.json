{
  "name": "shohoj",
  "version": "0.5.0",
  "description": "BRACU academic tools platform",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node scripts/run-tests.mjs && npm run test:rules",
    "test:unit": "node scripts/run-tests.mjs",
    "test:one": "node scripts/run-tests.mjs",
    "test:worker": "node worker/test/worker.test.js",
    "dev": "vite",
    "dev:shell": "vite --config vite.shell.config.js",
    "build:vite": "vite build",
    "build:shell": "vite build --config vite.shell.config.js",
    "preview": "vite preview",
    "preview:shell": "vite preview --config vite.shell.config.js",
    "test:rules": "firebase emulators:exec --only firestore --project shohoj-test \"node tests/firestore.rules.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:vite": "npm run build:vite && playwright test --config=playwright.vite.config.js",
    "test:e2e:shell": "npm run build:shell && playwright test --config=playwright.shell.config.js",
    "test:bundle": "node tests/productionBundleSmoke.test.js",
    "test:csp": "node tests/cspInlineHandlers.test.js",
    "check:collisions": "python3 scripts/check_bundle_collisions.py",
    "lint": "eslint .",
    "validate:data": "node scripts/validate_data.mjs",
    "typecheck": "tsc --noEmit",
    "set:admin": "node scripts/set_admin_claim.js",
    "config:local": "node scripts/generate_runtime_config.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.22.0",
    "globals": "^17.6.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.1",
    "zod": "^3.25.76"
  },
  "overrides": {
    "uuid": ">=11.1.1"
  }
}
