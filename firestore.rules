rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isAdmin() {
      // Admins are tagged with a custom claim set via scripts/set_admin_claim.js;
      // see PROJECT_README for setup. UID/email are no longer trusted here.
      return request.auth != null && request.auth.token.admin == true;
    }

    function isBracuUser() {
      return request.auth != null
        && (request.auth.token.email.matches('^[^@]+@g[.]bracu[.]ac[.]bd$')
            || isAdmin());
    }

    function validRating(v) {
      return v is int && v >= 1 && v <= 5;
    }

    function validCourseCode(code) {
      return code is string
        && code.matches('^[A-Z]{2,4}[0-9]{3}[A-Z]?$');
    }

    function validReviewId(id) {
      return id is string
        && id.matches('^[A-Z]{2,6}_[A-Z]{2,4}[0-9]{3}[A-Z]?_[a-f0-9]{64}$');
    }

    function validRatings(r) {
      return r.keys().hasOnly(['teaching','marking','behavior','difficulty','workload'])
        && r.keys().hasAll(['teaching','marking','behavior','difficulty','workload'])
        && validRating(r.teaching)
        && validRating(r.marking)
        && validRating(r.behavior)
        && validRating(r.difficulty)
        && validRating(r.workload);
    }

    function validReviewPayload(d) {
      // Exact key set — no extra fields allowed.
      return d.keys().hasOnly(['facultyInitials','courseCode','semester','ratings','text','createdAt'])
        && d.keys().hasAll(['facultyInitials','courseCode','ratings','createdAt'])
        && d.facultyInitials is string
        && d.facultyInitials.matches('^[A-Z]{2,6}$')
        && validCourseCode(d.courseCode)
        && validRatings(d.ratings)
        && (!('text' in d) || (d.text is string && d.text.size() <= 500))
        && (!('semester' in d) || (d.semester is string && d.semester.size() <= 40))
        && d.createdAt == request.time;
    }

    function validReviewReportPayload(d) {
      return d.keys().hasOnly(['reviewId','reason','reporterUid','createdAt'])
        && d.keys().hasAll(['reviewId','reason','reporterUid','createdAt'])
        && validReviewId(d.reviewId)
        && exists(/databases/$(database)/documents/facultyReviews/$(d.reviewId))
        && d.reason is string
        && d.reason.size() >= 3
        && d.reason.size() <= 300
        && d.reporterUid is string
        && d.reporterUid == request.auth.uid
        && d.createdAt == request.time;
    }

    // ── User data: scoped to own UID, BRACU domain only ──────────────────
    // Doc shape is constrained to {data: <serialized JSON string>, updatedAt}
    // and capped at 500 KB to bound storage abuse by individual users.
    function validUserDocPayload(d) {
      return d.keys().hasOnly(['data', 'updatedAt'])
        && 'data' in d
        && d.data is string
        && d.data.size() <= 500000
        && (!('updatedAt' in d) || d.updatedAt == request.time);
    }

    match /users/{uid} {
      allow read, delete: if isBracuUser() && request.auth.uid == uid;
      allow create, update: if isBracuUser()
        && request.auth.uid == uid
        && validUserDocPayload(request.resource.data);
    }

    // ── Faculty reviews: BRACU students can read; writes go via the Worker ──
    // Each review doc uses a DETERMINISTIC ID:
    //   {facultyInitials}_{courseCode}_{64-char lowercase hex}
    // where the hex suffix = sha256(uid + '|' + facultyInitials + '|' + courseCode).
    //
    // The Cloudflare Worker (worker/index.js POST /reviews) is the ONLY
    // writer — it computes the hash server-side using the verified Firebase
    // uid and writes via the Firestore REST API with a service-account OAuth
    // token, which bypasses these rules. Client-side creates are denied so
    // that the deterministic-ID guarantee can't be subverted by spamming
    // arbitrary hex suffixes.
    match /facultyReviews/{reviewId} {
      allow read: if isBracuUser();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // ── Review reports (abuse flagging) ──────────────────────────────────
    // Any signed-in BRACU user can create one report per review. Reports are
    // not readable from the client — admins triage via the Firebase console /
    // admin SDK.
    match /reviewReports/{reportId} {
      allow read: if isAdmin();

      allow create: if isBracuUser()
        && validReviewReportPayload(request.resource.data)
        && reportId == request.auth.uid + '_' + request.resource.data.reviewId;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Faculty profiles: read-only for students, admin-seeded ───────────
    match /facultyProfiles/{initials} {
      allow read: if isBracuUser();
      allow write: if false;
    }

    // ── App feedback ─────────────────────────────────────────────────────
    function validFeedbackType(t) {
      return t == 'bug' || t == 'feature' || t == 'general';
    }

    function validFeedbackPayload(d) {
      return d.keys().hasOnly(['type','text','context','anonymous','uid','createdAt'])
        && d.keys().hasAll(['type','text','anonymous','createdAt'])
        && validFeedbackType(d.type)
        && d.text is string
        && d.text.size() >= 3
        && d.text.size() <= 500
        && d.anonymous is bool
        && d.createdAt == request.time
        && (!('context' in d) || (d.context is map && d.context.size() <= 8))
        && (!('uid' in d) || d.uid == request.auth.uid);
    }

    match /appFeedback/{feedbackId} {
      allow read:   if isBracuUser();
      allow create: if isBracuUser() && validFeedbackPayload(request.resource.data);
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /appFeedbackUpvotes/{voteId} {
      allow read:   if isAdmin() || (isBracuUser() && resource.data.uid == request.auth.uid);
      allow create: if isBracuUser()
        && request.resource.data.keys().hasOnly(['feedbackId','uid','createdAt'])
        && request.resource.data.keys().hasAll(['feedbackId','uid','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.feedbackId is string
        && request.resource.data.feedbackId.size() > 0
        && request.resource.data.createdAt == request.time
        && voteId == request.resource.data.feedbackId + '_' + request.auth.uid;
      allow delete: if isBracuUser() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── Past papers & notes library (Phase 2) ────────────────────────────
    // Doc IDs are Firestore auto-IDs (multiple uploads per user/course are
    // allowed). Uploads land with `approved: false` and become visible only
    // after an admin flips the flag in the Firebase console. Clients filter
    // public views with `where('approved','==',true)`.
    function validPaperType(t) {
      return t == 'midterm' || t == 'final' || t == 'quiz'
          || t == 'notes'   || t == 'assignment' || t == 'lab'
          || t == 'lab-quiz';
    }

    function validPaperMime(m) {
      return m == 'application/pdf'
          || m == 'image/png'
          || m == 'image/jpeg'
          || m == 'image/webp'
          || m == 'image/gif';
    }

    function validOwnedPaperStoragePath(d) {
      return d.storagePath is string
        && d.storagePath.split('/').size() == 4
        && d.storagePath.split('/')[0] == 'papers'
        && d.storagePath.split('/')[1] == d.courseCode
        && d.storagePath.split('/')[2] == d.uploaderUid
        && d.storagePath.split('/')[3].matches('^[A-Za-z0-9._-]+$');
    }

    function validPaperPayload(d) {
      return d.keys().hasOnly(['courseCode','type','semester','facultyInitials','title','storagePath','fileSize','mimeType','uploaderUid','downloads','flagCount','approved','createdAt'])
        && d.keys().hasAll(['courseCode','type','title','storagePath','fileSize','mimeType','uploaderUid','approved','createdAt'])
        && validCourseCode(d.courseCode)
        && validPaperType(d.type)
        && d.title is string
        && d.title.size() >= 3
        && d.title.size() <= 120
        && validOwnedPaperStoragePath(d)
        && d.fileSize is int
        && d.fileSize > 0
        && d.fileSize <= 10485760
        && d.mimeType is string
        && validPaperMime(d.mimeType)
        && d.uploaderUid is string
        && d.uploaderUid == request.auth.uid
        && d.approved is bool
        && d.approved == false
        && d.createdAt == request.time
        && (!('semester' in d) || (d.semester is string && d.semester.size() <= 40))
        && (!('facultyInitials' in d) || (d.facultyInitials is string && d.facultyInitials.matches('^[A-Z]{2,6}(, ?[A-Z]{2,6})*$')))
        && (!('downloads' in d) || (d.downloads is int && d.downloads == 0))
        && (!('flagCount' in d) || (d.flagCount is int && d.flagCount == 0));
    }

    function validPaperReportPayload(d) {
      return d.keys().hasOnly(['paperId','reason','reporterUid','createdAt'])
        && d.keys().hasAll(['paperId','reason','reporterUid','createdAt'])
        && d.paperId is string
        && d.paperId.size() > 0
        && exists(/databases/$(database)/documents/papers/$(d.paperId))
        && d.reason is string
        && d.reason.size() >= 3
        && d.reason.size() <= 300
        && d.reporterUid is string
        && d.reporterUid == request.auth.uid
        && d.createdAt == request.time;
    }

    match /papers/{paperId} {
      allow read:   if isAdmin()
                    || (isBracuUser()
                        && (resource.data.approved == true
                            || resource.data.uploaderUid == request.auth.uid));
      allow create: if isBracuUser() && validPaperPayload(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /paperReports/{reportId} {
      allow read:   if isAdmin();
      allow create: if isBracuUser()
        && validPaperReportPayload(request.resource.data)
        && reportId == request.auth.uid + '_' + request.resource.data.paperId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Admin audit logs ─────────────────────────────────────────────────
    // Append-only record of moderation actions. Admins can read, authors
    // can create their own entries (adminUid must match their token), and
    // nothing can be updated or deleted from the client — even by admins.
    function validAdminLogAction(a) {
      return a == 'approve_paper'
          || a == 'delete_paper'
          || a == 'delete_review'
          || a == 'delete_paper_report'
          || a == 'delete_review_report'
          || a == 'delete_feedback';
    }

    function validAdminLogPayload(d) {
      return d.keys().hasOnly(['action','adminUid','targetType','targetId','meta','createdAt'])
        && d.keys().hasAll(['action','adminUid','targetType','targetId','createdAt'])
        && validAdminLogAction(d.action)
        && d.adminUid is string
        && d.adminUid == request.auth.uid
        && d.targetType is string
        && d.targetType.size() <= 40
        && d.targetId is string
        && d.targetId.size() > 0
        && d.targetId.size() <= 200
        && (!('meta' in d) || (d.meta is map && d.meta.size() <= 16))
        && d.createdAt == request.time;
    }

    match /adminLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin() && validAdminLogPayload(request.resource.data);
      allow update, delete: if false;
    }

    // ── Catch-all: deny everything else ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
